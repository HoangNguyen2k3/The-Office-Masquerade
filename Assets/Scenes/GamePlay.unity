--- !u!114 &511418629
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 511418628}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a39da44f37720844ab6be8b8de035a57, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  storyTexts:
  - "Ng\u01B0\u1EDDi ta \u0111\u1ED3n r\u1EB1ng c\xF3 m\u1ED9t r\u01B0\u01A1ng kho
    b\xE1u \u0111\u01B0\u1EE3c c\u1EA5t gi\u1EA5u t\u1EEB th\u1EBF k\u1EF7 tr\u01B0\u1EDBc."
  - "Nhi\u1EC1u k\u1EBB \u0111\xE3 c\u1ED1 t\xECm ki\u1EBFm, nh\u01B0ng t\u1EA5t
    c\u1EA3 \u0111\u1EC1u th\u1EA5t b\u1EA1i..."
  - "Cho \u0111\u1EBFn khi \"H\u1EAFn\" xu\u1EA5t hi\u1EC7n."
  - "M\u1ED9t t\xEAn tr\u1ED9m s\u1EDF h\u1EEFu hai chi\u1EBFc m\u1EB7t n\u1EA1 k\u1EF3
    b\xED."
  - "M\u1EB7t n\u1EA1 Qu\xE1 Kh\u1EE9 - m\u1EDF c\xE1nh c\u1EEDa v\u1EC1 th\u1EDDi
    x\u01B0a c\u0169."
  - "M\u1EB7t n\u1EA1 Hi\u1EC7n T\u1EA1i - \u0111\u01B0a h\u1EAFn tr\u1EDF v\u1EC1
    th\u1EF1c t\u1EA1i."
  - "V\u1EDBi s\u1EE9c m\u1EA1nh du h\xE0nh th\u1EDDi gian..."
